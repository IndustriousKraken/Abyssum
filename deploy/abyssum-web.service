# Abyssum web UI — systemd unit (template).
#
# abyssum-web is a self-contained binary: it embeds its web assets and defaults
# its config/database to absolute per-user paths, so it needs no source checkout.
#
# Copy to /etc/systemd/system/abyssum-web.service, edit the marked lines, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now abyssum-web
#
# Redeploy a new version (settings live here, not in your shell):
#   ./install.sh && sudo systemctl restart abyssum-web
#
# EDIT before use:
#   User=/Group=   the account to run as
#   ExecStart=     path to the installed abyssum-web binary
#
# Config is optional — built-in defaults apply. To supply a file, point
# ABYSSUM_CONFIG at an absolute path (commented line below).
#
# Binary in ~/.local/bin (a non-root install.sh)? Set User= to your account,
# ExecStart=/home/<you>/.local/bin/abyssum-web, and change `ProtectHome=true`
# to `ProtectHome=read-only` so systemd can read the binary from your home.

[Unit]
Description=Abyssum web UI
Documentation=https://github.com/IndustriousKraken/Abyssum
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abyssum
Group=abyssum
ExecStart=/usr/local/bin/abyssum-web

# --- Runtime config ----------------------------------------------------------
# A config file is optional (built-in defaults + the env overrides below apply if
# absent). To use one, point ABYSSUM_CONFIG at an absolute path readable by the
# service account, e.g.:
# Environment=ABYSSUM_CONFIG=/etc/abyssum/abyssum.yaml
# Absolute DB path (systemd creates /var/lib/abyssum via StateDirectory below),
# so persistence never depends on the working directory.
Environment=ABYSSUM_DATABASE_PATH=/var/lib/abyssum/abyssum.db
# Bind address. Unset = 127.0.0.1 — correct when behind the Caddy reverse proxy
# (deploy/Caddyfile.example), which is the recommended setup. Uncomment ONLY for
# direct, UNENCRYPTED LAN access on a trusted network:
# Environment=ABYSSUM_SERVER_HOST=0.0.0.0

Restart=on-failure
RestartSec=5
LimitNOFILE=65536
TimeoutStopSec=20

# --- Security hardening (if something breaks, comment from the bottom up) -----
# The SQLite data directory is the only writable path; systemd creates and
# owns /var/lib/abyssum and adds it to the writable set automatically.
StateDirectory=abyssum

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
# TCP for the listener + outbound scanner/AI traffic; UDP resolves DNS.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
